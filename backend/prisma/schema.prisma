generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model event_images {
  id           Int           @id @default(autoincrement()) @db.UnsignedInt
  event_id     Int           @db.UnsignedInt
  guest_id     Int?          @db.UnsignedInt
  url          String        @db.Text
  public_id    String        @unique(map: "uq_event_images_public_id") @db.VarChar(255)
  alt_text     String?       @db.VarChar(255)
  position     Int           @default(0) @db.UnsignedInt
  is_cover     Boolean       @default(false)
  created_at   DateTime      @default(now()) @db.Timestamp(0)
  updated_at   DateTime      @default(now()) @db.Timestamp(0)
  events       events        @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "fk_event_images_event")
  event_guests event_guests? @relation(fields: [guest_id], references: [id], onUpdate: Restrict, map: "fk_event_images_guest")

  @@index([event_id, is_cover], map: "idx_event_images_event_cover")
  @@index([event_id], map: "idx_event_images_event_id")
  @@index([event_id, position], map: "idx_event_images_event_position")
  @@index([guest_id], map: "idx_event_images_guest_id")
}

model events {
  id           Int            @id @default(autoincrement()) @db.UnsignedInt
  public_id    String         @unique(map: "uq_events_public_id") @default(uuid()) @db.Char(36)
  title        String         @db.VarChar(150)
  description  String?        @db.Text
  start_at     DateTime?      @db.DateTime(0)
  end_at       DateTime?      @db.DateTime(0)
  location     String?        @db.VarChar(255)
  event_type   String         @default("other") @db.VarChar(40)
  upload_deadline DateTime?   @db.DateTime(0)
  cover_image_url String?     @db.Text
  cover_image_public_id String? @db.VarChar(255)
  theme_color String          @default("ocean") @db.VarChar(30)
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  updated_at   DateTime       @default(now()) @db.Timestamp(0)
  event_guests event_guests[]
  event_images event_images[]
  guest_otp_challenges guest_otp_challenges[]

  @@index([is_active, start_at], map: "idx_events_active_start")
}

model creators {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(120)
  email         String   @unique(map: "uq_creators_email") @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model event_guests {
  id                 Int            @id @default(autoincrement()) @db.UnsignedInt
  event_id           Int            @db.UnsignedInt
  name               String         @db.VarChar(100)
  email              String?        @db.VarChar(255)
  session_token_hash String         @unique(map: "uq_event_guests_session_token_hash") @db.Char(64)
  created_at         DateTime       @default(now()) @db.Timestamp(0)
  updated_at         DateTime       @default(now()) @db.Timestamp(0)
  events             events         @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_event_guests_event")
  event_images       event_images[]

  @@index([event_id, created_at], map: "idx_event_guests_event_created")
  @@index([event_id], map: "idx_event_guests_event_id")
  @@unique([event_id, email], map: "uq_event_guests_event_email")
}

model guest_otp_challenges {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  event_id    Int       @db.UnsignedInt
  email       String    @db.VarChar(255)
  name        String    @db.VarChar(100)
  code_hash   String    @db.Char(64)
  expires_at  DateTime  @db.DateTime(0)
  attempts    Int       @default(0) @db.UnsignedInt
  consumed_at DateTime? @db.DateTime(0)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  events      events    @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "fk_guest_otp_challenges_event")

  @@index([event_id, email, created_at], map: "idx_guest_otp_event_email_created")
}
